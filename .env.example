# Токен от @BotFather
BOT_TOKEN=123456789:AAAA...

# Твой Telegram user id (узнать: @userinfobot). Несколько — через запятую.
# Все остальные пользователи игнорируются молча.
ALLOWED_USER_IDS=123456789

# cookies.txt (Netscape-формат), экспортированный из браузера, где ты залогинен
# в Instagram (и, при желании, в YouTube). Без него Instagram почти всегда не работает.
# В docker-compose папка ./cookies монтируется в /cookies.
COOKIES_FILE=/cookies/cookies.txt

# Лимит размера файла для отправки в Telegram, МБ.
# Обычный Bot API: 50. Локальный Bot API сервер: до 2000.
# По умолчанию: 50, а если задан TELEGRAM_API_BASE — 2000.
#MAX_UPLOAD_MB=50

# Адрес локального Bot API сервера (профиль local-api в docker-compose).
#TELEGRAM_API_BASE=http://telegram-bot-api:8081

# Максимальная высота видео с YouTube (1080/720/480...).
#MAX_VIDEO_HEIGHT=1080

# JS-рантайм для yt-dlp (нужен для YouTube): deno (по умолчанию) или node.
#YTDLP_JS_RUNTIME=deno

# Сервер PO-токенов для YouTube (профиль pot в docker-compose). Нужен, если YouTube
# с IP сервера отвечает "Sign in to confirm you're not a bot".
#YTDLP_POT_PROVIDER_URL=http://pot-provider:4416

# HTTP/SOCKS прокси для скачивания (yt-dlp и gallery-dl).
#DOWNLOAD_PROXY=socks5://127.0.0.1:1080

# Сколько ссылок качать одновременно.
#CONCURRENCY=2

# Куда класть временные файлы.
#DOWNLOAD_DIR=/data

# Обновлять yt-dlp и gallery-dl при старте контейнера (1/0).
#UPDATE_ON_START=1

#LOG_LEVEL=INFO
